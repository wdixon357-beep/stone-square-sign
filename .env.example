# Copy to .env for local work. On Render these are set in the dashboard instead.

PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
OWNER_EMAIL=brodixonsaunders@stonesquare22pha.org

# The Senior and Junior Warden, comma separated. Only these two may hold the warden
# seat. Never commit the real addresses; this repository is public.
WARDEN_EMAILS=senior.warden@example.org,junior.warden@example.org
# Officers stay signed in while they use the desk at least once every 90 days.
MAX_UPLOAD_BYTES=12582912

# Meeting minutes are organized locally. No API key or external AI service is used.

# Postgres. Leave DATABASE_URL blank locally and the app runs on PGlite, which is
# Postgres compiled to WebAssembly and needs nothing installed. Set PGLITE_DIR to keep
# that data between restarts; leave it blank and it lives in memory, which is what the
# test suite wants.
#
# In production this must be the Neon POOLED connection string, the host with
# "-pooler" in it. Without it a free Render instance loses every signed document when
# it sleeps, because a free web service has no persistent disk.
DATABASE_URL=
PGLITE_DIR=.pglite

# Mail. Gmail or Google Workspace works and costs nothing at this volume.
# SMTP_PASS must be a Google App Password, generated at myaccount.google.com/apppasswords
# with two-step verification on. It is not the account password.
# Leave SMTP_HOST blank and mail is printed to the console instead of sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=brodixonsaunders@stonesquare22pha.org
SMTP_PASS=
MAIL_FROM="Stone Square Sign <brodixonsaunders@stonesquare22pha.org>"

# Optional. There is no free production SMS. Leave these blank and password reset
# codes are emailed instead, which needs no account and no card.

TRACKER_SSO_SHARED_SECRET=
CANDIDATE_TRACKER_URL=https://tracker.stonesquare22pha.org/

# Dues. Read-only Zeffy access. The key and campaign ids are NOT in this repository
# because it is public; copy them from the Lodge website's src/lib/dues-config.ts.
ZEFFY_API_KEY=
ZEFFY_DUES_CAMPAIGN_ID=
ZEFFY_CUSTOM_DUES_CAMPAIGN_ID=
ZEFFY_STALE_CAMPAIGN_ID=
DUES_RATE_CENTS=17500
DUES_YEAR=2026-2027

# Render gives each service a deploy hook URL under Settings. A POST to it starts a
# build, so deploys never need the dashboard. Treat it as a password: it lives here as
# a placeholder and in .env for real, and never goes into chat or a commit.
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxxxxxx?key=xxxxxxxx
